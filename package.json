{
  "name": "progressive-web-office",
  "version": "0.0.13",
  "description": "A simple office suite that runs entirely in the browser: edit .docx/.odt documents, .xlsx/.ods/.csv spreadsheets and view PDF files.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-celles/progressive-web-office.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/build-llms.mjs && node scripts/copy-schemas.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@pdfme/pdf-lib": "^6.2.2",
    "fflate": "^0.8.3",
    "markdown-it": "^15.0.2",
    "mathlive": "^0.111.0",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "ajv": "^8.20.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  }
}
