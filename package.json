{
  "name": "progressive-web-office",
  "version": "0.1.0",
  "description": "A simple office suite that runs entirely in the browser: edit .docx/.odt documents, .xlsx/.ods/.csv spreadsheets and view PDF files.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "Sébastien Celles (https://github.com/s-celles)",
  "repository": {
    "type": "git",
    "url": "https://github.com/s-celles/progressive-web-office.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs && node scripts/build-llms.mjs && node scripts/copy-schemas.mjs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
