    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@pdfme/pdf-lib": "^6.2.2",
    "@scelles/collab": "github:s-celles/QRShare#collab-dist-v0.2.0",
    "@types/markdown-it-footnote": "^3.0.4",
    "fflate": "^0.8.3",
    "lean-qr": "^2.7.4",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
